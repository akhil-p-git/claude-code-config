{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "EDITOR": "vim",
    "GIT_EDITOR": "vim",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "VERCEL_PLUGIN_TELEMETRY": "off",
    "ENABLE_STOP_REVIEW": "0"
  },
  "permissions": {
    "allow": [
      "Edit(*)",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(gcc:*)",
      "Bash(make:*)",
      "Bash(pytest:*)",
      "Bash(jest:*)",
      "Bash(vitest:*)",
      "Bash(gh:*)",
      "Bash(docker:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "ask": [
      "Bash(gh skill install *)",
      "Bash(gh skill update *)",
      "Bash(npx skills *)",
      "Bash(claude plugin install *)",
      "Bash(claude plugin marketplace add *)",
      "mcp__plugin_vercel_vercel__request_*",
      "mcp__plugin_vercel_vercel__create_deployment",
      "mcp__plugin_vercel_vercel__cancel_deployment",
      "mcp__plugin_vercel_vercel__start_rolling_release",
      "mcp__plugin_vercel_vercel__complete_rolling_release",
      "mcp__plugin_vercel_vercel__approve_rolling_release_stage",
      "mcp__plugin_vercel_vercel__update_*",
      "mcp__plugin_vercel_vercel__edit_*",
      "mcp__plugin_vercel_vercel__patch_*",
      "mcp__plugin_vercel_vercel__put_*",
      "mcp__plugin_vercel_vercel__add_*",
      "mcp__plugin_vercel_vercel__replace_*",
      "mcp__plugin_vercel_vercel__restore_*",
      "mcp__plugin_vercel_vercel__stage_*",
      "mcp__plugin_vercel_vercel__assign_alias",
      "mcp__plugin_vercel_vercel__create_project_env",
      "mcp__plugin_vercel_vercel__create_record",
      "mcp__plugin_vercel_vercel__create_flag",
      "mcp__plugin_vercel_vercel__create_drain",
      "mcp__plugin_vercel_vercel__pause_project",
      "mcp__plugin_vercel_vercel__unpause_project",
      "mcp__plugin_vercel_vercel__buy_*",
      "mcp__plugin_vercel_vercel__create_or_transfer_domain",
      "mcp__plugin_vercel_vercel__invalidate_*",
      "mcp__plugin_vercel_vercel__revoke_*",
      "mcp__plugin_vercel_vercel__accept_project_transfer_request"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.production)",
      "Read(//**/.env.prod)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*.keystore)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/id_dsa*)",
      "Read(//**/secrets/**)",
      "Read(~/.secrets.env)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.local/share/com.vercel.cli/**)",
      "Read(~/.local/share/kwalletd/**)",
      "Read(~/.config/google-chrome/**)",
      "Read(~/.config/chromium/**)",
      "Read(~/.mozilla/**)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Read(~/.local/share/fish/fish_history)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.aws/**)",
      "Bash(mkfs:*)",
      "Bash(shred:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/guard-destructive.sh",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/guard-prod-actions.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/guard-git-secrets.sh",
            "timeout": 10,
            "if": "Bash(git *)"
          },
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/secret-scan-git.sh",
            "timeout": 30,
            "if": "Bash(git *)"
          }
        ]
      },
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/guard-destructive.sh",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/guard-prod-actions.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/protect-files.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/note-verification.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/bash-audit-log.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/bash-audit-log.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/format-on-edit.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/note-verification.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/bash-audit-log.sh",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/capture-lesson.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/session-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/verify-gate.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/notify.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/home/akhil/dev/claude-code-config/.claude/statusline.sh",
    "padding": 1
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": false,
    "allowUnsandboxedCommands": true
  },
  "spinnerTipsEnabled": true,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "verbose": false,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  }
}
