{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "EDITOR": "vim",
    "GIT_EDITOR": "vim",
    "VERCEL_PLUGIN_TELEMETRY": "off",
    "ENABLE_STOP_REVIEW": "0"
  },
  "permissions": {
    "allow": [
      "Edit(*)",
      "Bash(git:*)",
      "Bash(npm:*)",
      "Bash(pnpm:*)",
      "Bash(yarn:*)",
      "Bash(pip:*)",
      "Bash(gcc:*)",
      "Bash(make:*)",
      "Bash(pytest:*)",
      "Bash(jest:*)",
      "Bash(vitest:*)",
      "Bash(gh:*)",
      "Bash(docker:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "deny": [
      "Read(//**/.env)",
      "Read(//**/.env.local)",
      "Read(//**/.env.*.local)",
      "Read(//**/.env.production)",
      "Read(//**/.env.prod)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)",
      "Read(//**/*.p12)",
      "Read(//**/*.pfx)",
      "Read(//**/*.keystore)",
      "Read(//**/id_rsa*)",
      "Read(//**/id_ed25519*)",
      "Read(//**/id_dsa*)",
      "Read(//**/secrets/**)",
      "Read(~/.secrets.env)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.local/share/com.vercel.cli/**)",
      "Read(~/.local/share/kwalletd/**)",
      "Read(~/.config/google-chrome/**)",
      "Read(~/.config/chromium/**)",
      "Read(~/.mozilla/**)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Read(~/.local/share/fish/fish_history)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.aws/**)",
      "Bash(mkfs:*)",
      "Bash(shred:*)"
    ],
    "ask": [
      "Bash(gh skill install *)",
      "Bash(gh skill update *)",
      "Bash(npx skills *)",
      "Bash(claude plugin install *)",
      "Bash(claude plugin marketplace add *)",
      "mcp__plugin_vercel_vercel__request_*",
      "mcp__plugin_vercel_vercel__create_deployment",
      "mcp__plugin_vercel_vercel__cancel_deployment",
      "mcp__plugin_vercel_vercel__start_rolling_release",
      "mcp__plugin_vercel_vercel__complete_rolling_release",
      "mcp__plugin_vercel_vercel__approve_rolling_release_stage",
      "mcp__plugin_vercel_vercel__update_*",
      "mcp__plugin_vercel_vercel__edit_*",
      "mcp__plugin_vercel_vercel__patch_*",
      "mcp__plugin_vercel_vercel__put_*",
      "mcp__plugin_vercel_vercel__add_*",
      "mcp__plugin_vercel_vercel__replace_*",
      "mcp__plugin_vercel_vercel__restore_*",
      "mcp__plugin_vercel_vercel__stage_*",
      "mcp__plugin_vercel_vercel__assign_alias",
      "mcp__plugin_vercel_vercel__create_project_env",
      "mcp__plugin_vercel_vercel__create_record",
      "mcp__plugin_vercel_vercel__create_flag",
      "mcp__plugin_vercel_vercel__create_drain",
      "mcp__plugin_vercel_vercel__pause_project",
      "mcp__plugin_vercel_vercel__unpause_project",
      "mcp__plugin_vercel_vercel__buy_*",
      "mcp__plugin_vercel_vercel__create_or_transfer_domain",
      "mcp__plugin_vercel_vercel__invalidate_*",
      "mcp__plugin_vercel_vercel__revoke_*",
      "mcp__plugin_vercel_vercel__accept_project_transfer_request"
    ]
  },
  "model": "sonnet",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/guard-destructive.sh",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/guard-prod-actions.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/guard-git-secrets.sh",
            "if": "Bash(git *)",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/secret-scan-git.sh",
            "if": "Bash(git *)",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/guard-destructive.sh",
            "timeout": 10,
            "onFailure": "block"
          },
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/guard-prod-actions.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/protect-files.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/note-verification.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/bash-audit-log.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/bash-audit-log.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/format-on-edit.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/note-verification.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/bash-audit-log.sh",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/capture-lesson.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/session-start.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/session-context.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/verify-gate.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/akhil/dev/claude-code-config/.claude/hooks/notify.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "/home/akhil/dev/claude-code-config/.claude/statusline.sh",
    "padding": 1
  },
  "enabledPlugins": {
    "code-simplifier@claude-plugins-official": true,
    "vercel@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "clangd-lsp@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": false,
    "allowUnsandboxedCommands": true
  },
  "spinnerTipsEnabled": true,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-sonnet-4-6": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "verbose": false,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public — not queryable for the starting directory (no git remotes present); ~/dev/claude-code-config (github.com/akhil-p-git/claude-code-config) is PUBLIC per its own CLAUDE.md",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: not queryable (gh lookup unavailable; no git remote in starting directory)",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine or CI runner with open internet",
      "**Source control**: The trusted repo and its remote(s) only (no additional orgs configured)",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured — rapidphotoupload-media (config-derived — not a confirmed upload destination; uploads of local data still require confirmation) was found once in one config file in the repo tree and is not usage-corroborated, so it is not adopted as trusted",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: any file or store holding personal data, confidential business data, credentials, regulated data, or similarly sensitive material; preserve exact handles when known and share only with audiences cleared at the [named+specifics] bar — note: scan found .env/.env.local files under work/ (hrApp, Social Media Bot, localLLM, localAI) and .claude/.credentials.json, treat as credential-bearing",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development, including maintenance of a personal public Claude Code config repo (~/dev/claude-code-config, github.com/akhil-p-git/claude-code-config, PUBLIC)",
      "**Trusted repo**: no git repository detected at the starting directory (/home/akhil has 0 tracked files, no remotes); ~/dev/claude-code-config (github.com/akhil-p-git/claude-code-config, PUBLIC) is the one repo with corroborated identity from its own docs — treat other repos under ~ (hrApp, java-core, kedb-tracker, triagebot, statuspulse, java-practice) as unvetted candidates, not trusted, since scope is just-this-project and none is the working repo",
      "**Org-specific CLIs**: None configured",
      "routine under claude-code-config/ prefix: per that repo's own CLAUDE.md, \"git push\" there is a standing exception to the push-approval rule — unverified provenance from repo-authored docs, not adopted as a trust grant here, offered only as context"
    ],
    "classifyAllShell": true
  }
}
