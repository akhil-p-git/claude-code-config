# Optional API keys for this Claude Code config.
#
# Put real values in ~/.secrets.env (gitignored, sourced from ~/.bashrc).
# Do NOT put them in ~/.bashrc directly, and never in .claude/settings.json —
# the settings `env` block does NOT expand shell variables, so a value like
# "$GITHUB_TOKEN" is passed through as that literal 12-character string.

# ---------------------------------------------------------------------------
# DELIBERATELY NOT LISTED AS REQUIRED
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY — do NOT set this if you sign in with a claude.ai
#   subscription (the normal case). Setting it overrides OAuth login, switches
#   you to per-token API billing, and disables claude.ai connectors and Remote
#   Control. `claude doctor` reports this. Set it only for genuine API-key use.
#
# GITHUB_TOKEN — usually unnecessary. `gh auth login` stores a real token in the
#   system keyring and git picks it up via the gh credential helper. An exported
#   GITHUB_TOKEN *overrides* that, so a stale or placeholder value silently
#   breaks every push. Prefer `gh auth login`.

# ---------------------------------------------------------------------------
# Needed only by the external-model slash commands
# ---------------------------------------------------------------------------
# /gpt4 /gpt4o /gpt35 /o1
export OPENAI_API_KEY='sk-...'

# /opus /gemini /deepseek /llama /mistral /perplexity /query /compare /allmodel /models
export OPENROUTER_API_KEY='sk-or-v1-...'

# ---------------------------------------------------------------------------
# Needed only if you add the matching MCP server (see docs/MCP.md)
# ---------------------------------------------------------------------------
# export RENDER_API_KEY='rnd_...'
# export N8N_API_KEY='...'
# export POSTGRES_CONNECTION_STRING='postgresql://user:pass@host:5432/db'
