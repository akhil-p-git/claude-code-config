# Backup files created by setup script
*.backup

# OS files
.DS_Store

# Local overrides (not shared)
.local/
local-*.sh

# Auto-captured lessons inbox (machine-local; may contain raw prompts)
lessons-inbox.md
*.local.md

# local backups made before applying settings changes
.claude/settings.json.bak-*
.claude/*.proposed

# Skills Claude Code syncs from the claude.ai account into ~/.claude/skills/synced/.
# Machine-managed cache, and several are proprietary ("All rights reserved") —
# never commit them to this PUBLIC repo. Removed synced skills are moved to .trash/.
.claude/skills/synced/
.claude/skills/.trash/

# Hook test fixtures (throwaway git repos) and outputs, generated by .claude/hooks/tests/*.sh
.claude/hooks/tests/fx/
.claude/hooks/tests/out/

# Python bytecode from running bundled skill scripts
__pycache__/
*.pyc
